# Copy to .env and fill in. .env is gitignored -- keep it that way.

# --- Base de datos ------------------------------------------------------------------
# Alimentan al daemon y al servicio `migrate` de compose, que arma con ellas la
# DATABASE_URL de dbmate: DB_HOST debe resolver desde dentro del contenedor, y
# DB_PASSWORD va dentro de una URL (percent-encodearla si trae @ : / ? # % o &).
DB_HOST=host
DB_PORT=5432
DB_NAME=postgres
DB_USER=sistemas
DB_PASSWORD=changeme
DB_SCHEMA=monitoreo_faena

# --- Archivo de fin de faena (tipificador) ------------------------------------------
EDU_PATH=/mnt/tipificador
STOPFILE_POLL_SECONDS=30

# --- Variador -----------------------------------------------------------------------
NORIA_CONV=4.23
SPEED_DEADBAND_HZ=0.2
SPEED_MAX_INTERVAL_SECONDS=60

# --- Muestreo -----------------------------------------------------------------------
POLL_SECONDS=1
REASSERT_SECONDS=60
HEARTBEAT_SECONDS=60
STATUS_GRACE_SECONDS=30

# --- Tags fijos por PLC (contadores y entradas salen de counters_name) -------------
TAG_FREC=frec
TAG_STATUS=status

# --- Redis ---------------------------------------------------------------------------
REDIS_STREAM=paradas:events
REDIS_GROUP=writer
REDIS_CONSUMER=writer
REDIS_MAXLEN=100000
REDIS_BLOCK_MS=1000
PUBLISH_BUFFER_SIZE=5000

# --- Plumbing -----------------------------------------------------------------------
BATCH_MAX_EVENTS=500
BACKOFF_INITIAL_SECONDS=1
BACKOFF_MAX_SECONDS=30
SHUTDOWN_GRACE_SECONDS=20
LOG_LEVEL=INFO
