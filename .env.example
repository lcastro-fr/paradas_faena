# Copy to .env and fill in. .env is gitignored -- keep it that way.

# --- Base de datos ------------------------------------------------------------------
# Alimentan al daemon y al servicio `migrate` de compose, que arma con ellas la
# DATABASE_URL de dbmate: DB_HOST debe resolver desde dentro del contenedor, y
# DB_PASSWORD va dentro de una URL (percent-encodearla si trae @ : / ? # % o &).
DB_HOST=host
DB_PORT=5432
DB_NAME=postgres
DB_USER=sistemas
DB_PASSWORD=changeme
DB_SCHEMA=monitoreo_faena

# --- Archivo de fin de faena (tipificador) ------------------------------------------
EDU_PATH=/mnt/tipificador
STOPFILE_POLL_SECONDS=30

# --- Variador -----------------------------------------------------------------------
NORIA_CONV=4.23
SPEED_DEADBAND_HZ=0.2
SPEED_MAX_INTERVAL_SECONDS=60

# --- Muestreo -----------------------------------------------------------------------
POLL_SECONDS=1
REASSERT_SECONDS=60
HEARTBEAT_SECONDS=60
STATUS_GRACE_SECONDS=30

# --- Tags fijos por PLC (contadores y entradas salen de counters_name) -------------
TAG_FREC=frec
TAG_STATUS=status

# --- Redis ---------------------------------------------------------------------------
# REDIS_MAXLEN acota el stream durable. Con la velocidad viva entran ~86k entradas por
# dia ademas de las durables: con el tope viejo de 100000 el colchon ante un writer
# caido baja de ~17 dias a poco mas de uno, y pasado eso Redis evicciona en silencio
# filas que nadie escribio todavia.
REDIS_STREAM=paradas:events
REDIS_GROUP=writer
REDIS_CONSUMER=writer
REDIS_MAXLEN=1000000
REDIS_BLOCK_MS=1000
PUBLISH_BUFFER_SIZE=5000

# --- Espejo vivo (para el monitor en tiempo real) ------------------------------------
# Efimero: si Redis no responde se descarta y no se reintenta, para no gastarle tiempo al
# ciclo de lectura. Con LIVE_ENABLED=false el daemon se comporta exactamente como antes.
LIVE_ENABLED=true
LIVE_KEY_PREFIX=paradas:live
LIVE_SPEED_SECONDS=1
# Vencen solas y esa es la senal de caida. El default es max(5, 3*POLL_SECONDS).
LIVE_TTL_SECONDS=5
LIVE_TIMEOUT_SECONDS=0.5
LIVE_RETRY_SECONDS=5

# En true la velocidad a 1 Hz tambien se guarda, y eso distorsiona el promedio ponderado
# por tiempo de reporting.v_velocidad_franja.
PERSIST_LIVE_SPEED=false

# --- Django (la app web) --------------------------------------------------------------
# Dos bases. Las DB_* de arriba son la de dominio, que migra dbmate y Django sólo lee (más
# las dos tablas de configuración que se editan desde el admin). Las DJANGO_DB_* son la
# propia de Django: auth, sesiones y admin. Si no se definen, caen al mismo servidor que
# las DB_* con la base paradas_faena_app.
# ALLOWED_HOSTS vacío rechaza todo con un 400 mudo, y compose define `KEY: ${KEY}` como ""
# cuando la clave falta en el .env: por eso settings.py cae a un default en vez de a [].
DJANGO_DB_NAME=paradas_faena_app
DJANGO_DB_HOST=
DJANGO_DB_PORT=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=

DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_COOKIES=false
DJANGO_LOG_LEVEL=INFO

# --- Keycloak (OIDC) ------------------------------------------------------------------
# Del lado de Keycloak hay que cargar como redirect URI
#   <base>/accounts/oidc/keycloak/login/callback/
# y un mapper de group membership que emita el claim `groups`. Los nombres de grupo tienen
# que coincidir con los de auth_group en Django; los que no existan se ignoran.
KEYCLOAK_SERVER_URL=https://keycloak.rioplatense.com
KEYCLOAK_REALM=faena
KEYCLOAK_CLIENT_ID=paradas-faena
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_GROUPS_CLAIM=groups
KEYCLOAK_GROUP_PREFIX=
KEYCLOAK_SUPERUSER_GROUP=superuser

# --- Monitor en vivo -----------------------------------------------------------------
MONITOR_PORT=8080
MONITOR_REFRESH_SECONDS=60
MONITOR_HEARTBEAT_SECONDS=5
MONITOR_QUEUE_SIZE=200
MONITOR_STALE_SECONDS=15

# --- Plumbing -----------------------------------------------------------------------
BATCH_MAX_EVENTS=500
BACKOFF_INITIAL_SECONDS=1
BACKOFF_MAX_SECONDS=30
SHUTDOWN_GRACE_SECONDS=20
LOG_LEVEL=INFO
